{
    "name": "gnome-widgets",
    "version": "0.1.0",
    "description": "Theme-aware desktop widgets for GNOME Shell.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gaurav7902/gnome-widgets.git"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && stylelint 'styles/**/*.css'",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node scripts/test.mjs",
        "pack": "node scripts/pack.mjs",
        "verify-pack": "node scripts/verify-pack.mjs",
        "install-local": "npm run build && npm run pack && gnome-extensions install --force build/gaurav7902@thegorav.xyz.shell-extension.zip",
        "nested": "make nested",
        "logs": "make logs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@girs/clutter-14": "^14.0.0-4.0.0-beta.38",
        "@girs/cairo-1.0": "^1.0.0-4.0.0-rc.17",
        "@girs/gjs": "^4.0.0-beta.38",
        "@girs/glib-2.0": "^2.86.0-4.0.0-beta.38",
        "@girs/gnome-shell": "^49.1.0",
        "@girs/gobject-2.0": "^2.86.0-4.0.0-beta.38",
        "@girs/st-1.0": "^1.0.0-4.0.0-beta.38",
        "@typescript-eslint/parser": "^8.46.2",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.7.1",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.0",
        "typescript": "^5.9.3"
    }
}
